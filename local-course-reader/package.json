{
  "name": "local-course-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate.mjs && vite --host 127.0.0.1",
    "dev:lan": "node scripts/generate.mjs && vite --host 0.0.0.0",
    "build": "node scripts/generate.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:lan": "vite preview --host 0.0.0.0",
    "update-course": "node scripts/update-course.mjs",
    "test": "node --test tests/content.test.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "^11.11.2",
    "html-react-parser": "^6.1.7",
    "json5": "^2.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}
